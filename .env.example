# ─────────────────────────────────────────────────────────────
# Copiloto eDAY 2026 — variables de entorno
# Copiá este archivo a .env.local para desarrollo, y cargá los
# mismos valores en Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Transcripción en vivo (Deepgram). El servidor la usa para pedir
# tokens efímeros; NUNCA se expone al navegador.
DEEPGRAM_API_KEY=

# Análisis del pitch y cálculo de los 6 indicadores (Google Gemini).
GEMINI_API_KEY=

# Tiempo real entre /copiloto y /publico (Pusher Channels).
# La key es pública por diseño (viaja al navegador); el secret no.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=sa1

# Contraseña del panel del operador (/copiloto y las APIs de escritura).
# Si queda vacía, el panel queda ABIERTO y muestra un aviso en pantalla.
ADMIN_PASSWORD=

# Forzar el modelo de Gemini. Vacío = se descubre solo preguntándole a la API
# qué tiene habilitado la key, con dos perfiles: uno rápido para la medición
# en vivo (cada 12s) y uno mejor para la ficha final (una vez por equipo).
#   GEMINI_MODEL          fuerza los dos
#   GEMINI_MODEL_CALIDAD  fuerza sólo el de la ficha final
# Verificá cuáles quedaron elegidos en GET /api/gemini-check.
GEMINI_MODEL=
GEMINI_MODEL_CALIDAD=

# Persistencia durable de las fichas. Sin esto, en Vercel el historial no
# sobrevive entre invocaciones.
#
# Van LAS DOS o ninguna: con el token solo, el código no sabe a qué servidor
# pegarle y sigue en modo no durable sin avisar.
#
# Dos formas equivalentes, el código acepta cualquiera de los dos pares:
#   a) Vercel KV, desde el Marketplace (las inyecta solas).
KV_REST_API_URL=
KV_REST_API_TOKEN=
#   b) Upstash Redis creado directo en upstash.com, útil si ya gastaste la
#      base gratis que Vercel te da por cuenta. Copiá las dos de su panel,
#      pestaña "REST API" — sin comillas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
