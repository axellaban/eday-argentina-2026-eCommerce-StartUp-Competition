# ─────────────────────────────────────────────────────────────
# Copiloto eDAY 2026 — variables de entorno
# Copiá este archivo a .env.local para desarrollo, y cargá los
# mismos valores en Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Transcripción en vivo (Deepgram). El servidor la usa para pedir
# tokens efímeros; NUNCA se expone al navegador.
DEEPGRAM_API_KEY=

# Análisis del pitch y cálculo de los 6 indicadores (Google Gemini).
GEMINI_API_KEY=

# Tiempo real entre /copiloto y /publico (Pusher Channels).
# La key es pública por diseño (viaja al navegador); el secret no.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=sa1

# Contraseña del panel del operador (/copiloto y las APIs de escritura).
# Si queda vacía, el panel queda ABIERTO y muestra un aviso en pantalla.
ADMIN_PASSWORD=

# Persistencia durable de las fichas (Vercel KV o Upstash Redis).
# Sin esto, en Vercel el historial no sobrevive entre invocaciones.
KV_REST_API_URL=
KV_REST_API_TOKEN=
